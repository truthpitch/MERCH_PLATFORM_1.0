# Copy to .env.local for local development. On Hostinger, set these in
# hPanel → your Node.js app → Settings → Environment variables.
# NEXT_PUBLIC_* values are baked in at build time — redeploy after changing them.

# ---------------------------------------------------------------
# Site
# ---------------------------------------------------------------
# Public site URL (canonical URLs, Open Graph, sitemap, and links in emails)
NEXT_PUBLIC_SITE_URL=https://truthpitch.com

# Accounts, studio, dashboard. On by default; "false" hides sign-in.
NEXT_PUBLIC_ENABLE_AUTH=true

# Free standard shipping threshold in USD
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=75

# ---------------------------------------------------------------
# Database (Prisma)
# ---------------------------------------------------------------
# "sqlite" for local development, "mysql" on Hostinger.
DATABASE_PROVIDER=sqlite
# SQLite (local):
DATABASE_URL=file:./prisma/dev.db
# MySQL (Hostinger) — URL-encode special characters in the password:
# DATABASE_PROVIDER=mysql
# DATABASE_URL=mysql://u123_truthpitch:YOUR_PASSWORD@localhost:3306/u123_truthpitch
# Max MySQL connections per Node process (Hostinger shared plans: keep it small)
DATABASE_POOL_SIZE=5

# ---------------------------------------------------------------
# Auth (Auth.js / NextAuth v5)
# ---------------------------------------------------------------
# Required. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-a-long-random-string
# Needed behind Hostinger's proxy so Auth.js trusts the forwarded host.
AUTH_TRUST_HOST=true
# Optional — Google sign-in appears only when both are set.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorised redirect URI: https://truthpitch.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------
# Admin account (created by `npm run db:seed` if it doesn't exist)
# ---------------------------------------------------------------
ADMIN_EMAIL=you@truthpitch.com
# Leave empty to have the seed print a one-time random password instead.
ADMIN_PASSWORD=
# Adds 2 demo creators + 4 community designs. Use "true" locally, "false" in production.
SEED_DEMO_CONTENT=false

# ---------------------------------------------------------------
# Uploads (design artwork, avatars)
# ---------------------------------------------------------------
# Folder OUTSIDE the deployed app, so redeploying from GitHub never wipes uploads.
# Local default: ./storage/uploads.  Hostinger example: /home/u123456789/truthpitch-uploads
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_MB=10

# ---------------------------------------------------------------
# Not used yet — placeholders for real providers later
# ---------------------------------------------------------------
# Email (lib/email.ts currently logs to the server console)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=...
# EMAIL_FROM="TruthPitch <hello@truthpitch.com>"

# Stripe (payments — lib/commerce/providers.ts)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Printful (print-on-demand — lib/fulfillment.ts)
# PRINTFUL_API_KEY=...
# PRINTFUL_STORE_ID=...
