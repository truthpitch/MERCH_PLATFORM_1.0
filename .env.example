# Copy to .env.local for local development. On Hostinger, set these in
# hPanel → Websites → your site → Node.js → Environment variables.

# Public site URL (used for canonical URLs, Open Graph, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://truthpitch.com

# Feature flags
# Phase 2: set to "true" to show the "Sign in" link in the navbar.
NEXT_PUBLIC_ENABLE_AUTH=false

# Shipping — free shipping threshold in USD
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=75

# ---------------------------------------------------------------
# Not used yet — placeholders for plugging in real providers later
# ---------------------------------------------------------------

# Stripe (payments)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Printful (print-on-demand fulfillment)
# PRINTFUL_API_KEY=...
# PRINTFUL_STORE_ID=...

# Phase 2: database + auth
# DATABASE_URL=postgresql://user:password@host:5432/truthpitch
# AUTH_SECRET=...
