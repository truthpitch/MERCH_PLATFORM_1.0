{
  "name": "truthpitch-merch",
  "version": "1.0.0",
  "private": true,
  "description": "TruthPitch — creator brand home and merch store (Phase 1).",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/prisma/build/index.js generate && node node_modules/next/dist/bin/next build --webpack",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "node node_modules/prisma/build/index.js generate && node node_modules/next/dist/bin/next typegen && node node_modules/typescript/bin/tsc --noEmit",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node node_modules/prisma/build/index.js db seed",
    "db:reset": "node node_modules/prisma/build/index.js migrate reset",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:sync-mysql": "node scripts/db-mysql.mjs sync",
    "db:mysql-migration": "node scripts/db-mysql.mjs migration",
    "deploy:build": "npm run db:deploy && npm run db:seed && npm run build",
    "postinstall": "node node_modules/prisma/build/index.js generate"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^7.0.6",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "framer-motion": "^14.12.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "mariadb": "^3.5.5",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "better-sqlite3": "12.11.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
